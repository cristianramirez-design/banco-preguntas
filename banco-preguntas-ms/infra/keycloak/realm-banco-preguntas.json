{
  "realm": "banco-preguntas",
  "enabled": true,
  "displayName": "Banco de Preguntas Saber Pro",
  "accessTokenLifespan": 1800,
  "ssoSessionIdleTimeout": 7200,
  "ssoSessionMaxLifespan": 36000,
  "registrationAllowed": false,
  "loginWithEmailAllowed": false,
  "bruteForceProtected": true,
  "sslRequired": "none",
  "roles": {
    "realm": [
      {
        "name": "AUTOR",
        "description": "Docente que crea preguntas (HU-1, HU-2, HU-3, HU-6)"
      },
      {
        "name": "REVISOR",
        "description": "Docente par que evalua preguntas (HU-5)"
      },
      {
        "name": "ADMINISTRADOR",
        "description": "Coordinacion Saber Pro: asigna revisores (HU-4) y gestiona usuarios"
      }
    ]
  },
  "clients": [
    {
      "clientId": "banco-frontend",
      "name": "Frontend React del Banco de Preguntas",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://localhost:5173/*"
      ],
      "webOrigins": [
        "+"
      ],
      "attributes": {
        "post.logout.redirect.uris": "http://localhost:5173/*"
      },
      "protocol": "openid-connect",
      "fullScopeAllowed": true
    }
  ],
